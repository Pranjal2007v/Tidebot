# Copy this file to .env and fill it in. Only TIDEBOT_WEBHOOK_SECRET is
# required; leave a value empty to keep that feature off. The App's settings
# page on GitHub shows the IDs and secrets.

# Required: the webhook secret set in the GitHub App.
TIDEBOT_WEBHOOK_SECRET=

# Where the bot keeps its state (one JSON file).
TIDEBOT_STATE=state.json

# Let the bot reply: the App ID and the path to the App's private key (.pem).
TIDEBOT_APP_ID=
TIDEBOT_PRIVATE_KEY=

# AI commands: any OpenAI-compatible endpoint, such as https://api.example.com/v1.
# The key is optional, since local servers often have none.
TIDEBOT_AI_URL=
TIDEBOT_AI_MODEL=
TIDEBOT_AI_KEY=

# Dashboard: a shared token that can read every repo's numbers, and the sites
# (comma-separated) whose dashboard page may call the stats API.
TIDEBOT_STATS_TOKEN=
TIDEBOT_DASHBOARD_ORIGINS=

# Sign in with GitHub for the dashboard: the App's OAuth client ID and secret,
# and the bot's own address (the callback is <TIDEBOT_PUBLIC_URL>/auth/callback).
TIDEBOT_GITHUB_CLIENT_ID=
TIDEBOT_GITHUB_CLIENT_SECRET=
TIDEBOT_PUBLIC_URL=
